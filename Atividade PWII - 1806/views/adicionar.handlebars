<div class="container mt-5">
    <h1 class="mb-4">Cadastro de Usuário</h1>

    <form action="/adicionar" method="POST" class="card p-4 shadow-sm">
        <div class="mb-3">
            <label class="form-label">Nome:</label>
            <input type="text" name="nome" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Email:</label>
            <input type="email" name="email" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Senha:</label>
            <input type="password" name="senha" class="form-control" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Nível de Acesso:</label>
            <input type="number" name="nivacesso" class="form-control" min="1" max="2" required>
            <div class="form-text">1 = Admin, 2 = Usuário</div>
        </div>

        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-success">✅ Criar</button>
            <a href="/" class="btn btn-secondary">🏠 Voltar</a>
        </div>
    </form>
</div>