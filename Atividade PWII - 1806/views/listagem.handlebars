<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Lista de Usuários</h1>
        <div>
            <a href="/adicionar" class="btn btn-success">➕ Criar Novo Usuário</a>
        </div>
    </div>

    <form class="input-group mb-4" action="/pesquisar" method="GET">
        <input type="text" class="form-control" name="q" placeholder="Pesquisar por nome ou email...">
        <button class="btn btn-outline-primary" type="submit">🔍 Pesquisar</button>
    </form>

    <table class="table table-bordered table-hover table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Email</th>
                <th>Senha</th>
                <th>Nível de Acesso</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            {{#each listagem}}
            <tr>
                <td>{{id}}</td>
                <td>{{nome}}</td>
                <td>{{email}}</td>
                <td>{{senha}}</td>
                <td>{{nivacesso}}</td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            ⚙️ Configurações
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item text-danger" href="/excluir/{{id}}" onclick="return confirm('Tem certeza que deseja excluir este usuário?')">🗑️ Excluir</a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/trocarsenha/{{id}}">🔑 Trocar Senha</a>
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>